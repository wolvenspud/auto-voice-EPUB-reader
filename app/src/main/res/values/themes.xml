<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Minimal XML theme — Compose owns all visual theming.
        This exists only to satisfy the manifest android:theme attribute
        and to configure edge-to-edge window rendering.
    -->
    <style name="Theme.AutoVoiceReader" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
